# PostgreSQL migration evidence phase: pre-read cutover gate.
#
# Copy this file to a target-specific env file before use.
# This phase must run before PostgreSQL read is enabled and must skip API smoke.

TRADING_AGENTS_TARGET_ENV=trading_agents-staging
TRADING_AGENTS_CUTOVER_PHASE=pre-read

# Expected backend switch state while pre-read evidence is collected.
POSTGRES_DUAL_WRITE_ENABLED=true
POSTGRES_READ_ENABLED=false
SYNC_STOCK_BASICS_ENABLED=false
