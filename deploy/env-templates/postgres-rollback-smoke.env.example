# PostgreSQL migration evidence phase: rollback drill API smoke.
#
# Copy this file to a target-specific, secret-managed env file before use.
# Do not commit real API tokens, usernames, or passwords.

TRADINGAGENTS_TARGET_ENV=tradingagents-staging
TRADINGAGENTS_CUTOVER_PHASE=rollback

TRADINGAGENTS_API_BASE_URL=https://<target-host>
# Prefer a short-lived smoke token when available.
TRADINGAGENTS_API_TOKEN=
# Or use a smoke account instead of a token.
TRADINGAGENTS_API_USERNAME=<smoke-user>
TRADINGAGENTS_API_PASSWORD=<smoke-password>

TRADINGAGENTS_SMOKE_STOCK_CODE=000001
TRADINGAGENTS_SMOKE_SYMBOL=000001
TRADINGAGENTS_SMOKE_SEARCH_QUERY=000001
# Optional existing task id; leave empty to record the analysis task check as skipped.
TRADINGAGENTS_SMOKE_TASK_ID=

TRADINGAGENTS_EXPECT_POSTGRES_READ_ENABLED=false
TRADINGAGENTS_EXPECT_POSTGRES_DUAL_WRITE_ENABLED=true
