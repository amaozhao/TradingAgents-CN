# PostgreSQL migration evidence phase: post-read API smoke.
#
# Copy this file to a target-specific, secret-managed env file before use.
# Do not commit real API tokens, usernames, or passwords.

TRADING_AGENTS_TARGET_ENV=trading_agents-staging
TRADING_AGENTS_CUTOVER_PHASE=post-read

TRADING_AGENTS_API_BASE_URL=https://<target-host>
# Prefer a short-lived smoke token when available.
TRADING_AGENTS_API_TOKEN=
# Or use a smoke account instead of a token.
TRADING_AGENTS_API_USERNAME=<smoke-user>
TRADING_AGENTS_API_PASSWORD=<smoke-password>

TRADING_AGENTS_SMOKE_STOCK_CODE=000001
TRADING_AGENTS_SMOKE_SYMBOL=000001
TRADING_AGENTS_SMOKE_SEARCH_QUERY=000001
# Optional existing task id; leave empty to record the analysis task check as skipped.
TRADING_AGENTS_SMOKE_TASK_ID=

TRADING_AGENTS_EXPECT_POSTGRES_READ_ENABLED=true
TRADING_AGENTS_EXPECT_POSTGRES_DUAL_WRITE_ENABLED=true
